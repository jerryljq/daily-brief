<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jerrystudio.daily-brief-publish</string>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/python3</string>
    <string>/Users/jerry/Develop/JerryStudio/GithubPageHome/daily-brief/publish.py</string>
  </array>

  <!-- 简报 08:00 生成，历史上 08:02–09:52 之间写完。10:00 收一次，
       14:00 再收一次兜底（没有新简报就是空跑）。 -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>14</integer><key>Minute</key><integer>0</integer></dict>
  </array>

  <key>StandardOutPath</key>
  <string>/Users/jerry/Library/Logs/daily-brief-publish.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/jerry/Library/Logs/daily-brief-publish.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
